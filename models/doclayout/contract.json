  "labelSource": "config.json / inference.yml 的 label_list（顺序即类别 id），不是文档表格",
  "arch": {
    "name": "GFL (PicoDet-S 主干)",
    "fpnStride": [8, 16, 32, 64],
    "useDynamicShape": false
  },
  "input": {
    "image": {
      "name": "image",
      "shape": [1, 3, 480, 480],
      "layout": "NCHW",
      "dtype": "float32",
      "source": "inference.yml Preprocess.target_size + Hpi.paddle_infer.trt_dynamic_shapes"
    },
    "scale_factor": {
      "name": "scale_factor",
      "shape": [1, 2],
      "dtype": "float32",
      "source": "inference.yml Hpi.paddle_infer.trt_dynamic_shapes.scale_factor",
      "note": "ONNX 保留了这个输入（少喂会报 missing input）；产品恒喂 [1.0, 1.0]，输出坐标就留在 480 空间，映射由 LayoutTiler/Tile 负责"
    }
  },
  "preprocess": {
    "resize": "stretch",
    "keepRatio": false,
    "targetSize": [480, 480],
    "interpolation": "bilinear (interp: 2)",
    "isScale": true,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225],
    "permute": "HWC → CHW",
    "formula": "(v / 255 - mean) / std",
    "source": "inference.yml Preprocess（已逐字段核对）"
  },
  "postprocess": {
    "nms": {
      "type": "MultiClassNMS",
      "scoreThreshold": 0.3,
      "nmsThreshold": 0.5,
      "keepTopK": 100,
      "nmsTopK": 1000,
      "drawThreshold": 0.5,
      "source": "inference.yml NMS（已核对）"
    },
    "appThreshold": 0.4,
    "appNmsIou": 0.5,
    "appNote": "产品阈值比官方 score_threshold 略高，用来压掉手机截图上的低分误检；见 core/layout/LayoutOptions.kt",
    "onnxInGraph": {
      "note": "ONNX 图内已经做过一次 NMS，但阈值极低（score 0.025 / iou 0.6 / keep_top_k 100），不能当作产品后处理",
      "scoreThreshold": 0.025,
      "nmsThreshold": 0.6,
      "keepTopK": 100,
      "clientMustReFilter": true,
      "source": "models/doclayout/CONVERSION.md §5.3"
    }
  },
