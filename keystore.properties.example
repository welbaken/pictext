# release 签名配置模板。
#
# 复制到仓库根目录并改名为 `keystore.properties`（已在 .gitignore 里，不会入库），
# 再把下面四项换成自己的 keystore。文件不存在时 release 仍能构建，但产出 unsigned APK。
#
# 生成 keystore（示例；密码自己定，alias 也可以改）：
#   keytool -genkeypair -v -keystore D:/SRC/keys/pictext-release.jks ^
#     -alias pictext -keyalg RSA -keysize 4096 -validity 10000
#
# 然后：
#   ./gradlew.bat :app:assembleRelease
#   产物：app/build/outputs/apk/release/app-release.apk
#
# 校验：
#   apksigner verify --print-certs app/build/outputs/apk/release/app-release.apk
storeFile=D:/SRC/keys/pictext-release.jks
storePassword=CHANGE_ME
keyAlias=pictext
keyPassword=CHANGE_ME
